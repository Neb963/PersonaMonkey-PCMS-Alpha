{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neb963/persona-monkey-pcms/docs/implementation/v1/claims/CLAIM.schema.json",
  "title": "PCMS implementation claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claimId",
    "phaseId",
    "taskId",
    "claimEpoch",
    "state",
    "owner",
    "baseMainSha",
    "branch",
    "writePaths",
    "contractReads",
    "contractWrites",
    "resources",
    "migrationSlots",
    "acceptanceIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "claimId": {
      "type": "string",
      "pattern": "^CLM-P[0-9]{3}-[0-9]{3}$"
    },
    "phaseId": {
      "type": "string",
      "pattern": "^P[0-9]{3}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^T[0-9]{3}\\.[0-9]+$"
    },
    "claimEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "ACTIVE",
        "PR_OPEN",
        "MERGED",
        "ACCEPTED",
        "ABANDONED"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentId"
      ],
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseMainSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "pattern": "^agent/[^/]+/p[0-9]{3}-t[0-9]{3}-[0-9]+$"
    },
    "writePaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contractReads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sha"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "additionalProperties": false
      }
    },
    "contractWrites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "mode"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "exclusive",
              "shared-protocol"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "migrationSlots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptanceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[0-9]{3}-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "lastCheckpointSha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
