{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personamonkey.local/schema/workflow-package-v1.json",
  "title": "PersonaMonkey Workflow Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "package", "personas", "scripts", "workflow"],
  "properties": {
    "format": { "const": "personamonkey.workflow-package" },
    "formatVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "author": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 100 }
      }
    },
    "personas": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._-]+$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 2000 },
          "routeRequirement": { "enum": ["any", "networked", "protected", "direct"] },
          "sourceHint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "profileName": { "type": "string", "maxLength": 200 },
              "routeName": { "type": "string", "maxLength": 200 },
              "routeProvider": { "type": "string", "maxLength": 100 }
            }
          }
        }
      }
    },
    "scripts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "file", "name"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._-]+$" },
          "file": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^userscripts/(?!(?:\\.{1,2}/|.*/\\.{1,2}/))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.user\\.js$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "enabled": { "type": "boolean" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["personaKey", "urls"],
            "properties": {
              "id": { "type": "string", "maxLength": 100 },
              "personaKey": { "type": "string", "minLength": 1, "maxLength": 100 },
              "urls": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10000,
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
              },
              "concurrency": { "type": "integer", "minimum": 1, "maximum": 200 },
              "scriptKeys": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 100 }
              },
              "completion": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": { "enum": ["load", "delay", "selector", "signal"] },
                  "value": { "type": "string", "maxLength": 4096 },
                  "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
                }
              },
              "retries": { "type": "integer", "minimum": 0, "maximum": 10 },
              "retryDelayMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
              "closeTabs": { "type": "boolean" },
              "stopOnError": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
